{
  "manifest_version": 3,
  "name": "Batch Image Downloader",
  "description": "Save original images from a Files section or custom list to a folder of your choice.",
  "version": "1.1.0",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*",
    "file:///*"
  ],
  "action": {
    "default_title": "Download original images"
  },
  "background": {
    "service_worker": "launch.js"
  }
}